# Copy to .env and fill in. Never commit the real .env.

# MongoDB connection string
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/superbdiamonds

# Long random string used to sign login cookies and verification tokens
JWT_SECRET_KEY=change-me-to-a-long-random-string

# Gmail app password for superb.diamonds@gmail.com (used to send OTP emails)
TWO_FACTOR_AUTH=
# Optional: sender address (defaults to superb.diamonds@gmail.com)
MAIL_FROM=

PORT=4001
NODE_ENV=development

# Comma-separated frontend origins allowed to call the API with cookies.
# Leave empty to allow any origin (not recommended in production).
CORS_ORIGINS=http://localhost:3000,https://superbdiamonds.in,https://www.superbdiamonds.in

# Comma-separated accounts allowed to replace the shared RAP price list.
# Leave empty to let any logged-in user upload (previous behaviour).
ADMIN_EMAILS=

# Free-trial length for new signups, in days. Leave empty/0 for no expiry (previous behaviour).
TRIAL_DAYS=

# Session cookie overrides (defaults: SameSite=None, Secure=true)
COOKIE_SAMESITE=
COOKIE_SECURE=
